{
  "name": "ab-nextjs-icons",
  "version": "0.2.4",
  "description": "⭐️ A lightweight collection of icons for abElements created by Abraham Ukachi, and optimized for Next.js applications 😎.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/abraham-ukachi/ab-nextjs-icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham-ukachi/ab-nextjs-icons.git"
  },
  "bugs": {
    "url": "https://github.com/abraham-ukachi/ab-nextjs-icons/issues"
  },
  "scripts": {
    "build": "tsup --clean",
    "prepack": "pnpm build",
    "dev": "tsup --watch",
    "lint": "eslint . --fix",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:file": "vitest run",
    "test:name": "vitest run -t",
    "check:publish": "node scripts/check-publish-deps.mjs && node scripts/check-dist.mjs && python3 scripts/regenerate-ab-icons-meta.py --check",
    "prepublishOnly": "node scripts/check-publish-deps.mjs && node scripts/check-dist.mjs && python3 scripts/regenerate-ab-icons-meta.py --check",
    "readme:icons": "node scripts/readme-icons.mjs",
    "readme:icons:check": "node scripts/readme-icons.mjs --check",
    "icons:modules": "node scripts/icon-modules.mjs",
    "icons:modules:check": "node scripts/icon-modules.mjs --check",
    "icons:meta": "python3 scripts/regenerate-ab-icons-meta.py",
    "icons:meta:check": "python3 scripts/regenerate-ab-icons-meta.py --check"
  },
  "keywords": [
    "react",
    "nextjs",
    "icons",
    "abraham",
    "ukachi",
    "ab-nextjs-icons",
    "ab-elements"
  ],
  "author": {
    "name": "Abraham Ukachi",
    "url": "https://github.com/abraham-ukachi",
    "email": "abrahamukachi@gmail.com"
  },
  "license": "MIT",
  "files": [
    "dist",
    "css",
    "material-icons",
    "logos",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ant-design-icons",
    "pics",
    "launchers",
    "ab-icons",
    "!pics/me-nobg.png"
  ],
  "dependencies": {
    "material-symbols": "^0.29.0"
  },
  "devDependencies": {
    "@ant-design/icons-svg": "^4.6.0",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^9.1.0",
    "next": "16.3.4",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5",
    "vitest": "^3"
  },
  "peerDependencies": {
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
