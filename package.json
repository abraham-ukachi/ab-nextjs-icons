{
  "name": "ab-nextjs-icons",
  "version": "0.1.2",
  "description": "\u2b50\ufe0f A lightweight collection of icons for abElements created by Abraham Ukachi, and optimized for Next.js applications \ud83d\ude0e.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/abraham-ukachi/ab-nextjs-icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham-ukachi/ab-nextjs-icons.git"
  },
  "bugs": {
    "url": "https://github.com/abraham-ukachi/ab-nextjs-icons/issues"
  },
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsup --watch",
    "lint": "eslint . --fix",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:file": "vitest run",
    "test:name": "vitest run -t"
  },
  "keywords": [
    "react",
    "nextjs",
    "icons",
    "abraham",
    "ukachi",
    "ab-nextjs-icons",
    "ab-elements"
  ],
  "author": {
    "name": "Abraham Ukachi",
    "url": "https://github.com/abraham-ukachi",
    "email": "abraham.ukachi@laplateforme.io"
  },
  "license": "MIT",
  "files": [
    "dist",
    "css",
    "material-icons",
    "logos",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ant-design-icons",
    "pics",
    "launchers"
  ],
  "dependencies": {
    "material-symbols": "^0.29.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^9.1.0",
    "next": "16.3.4",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5",
    "vitest": "^3",
    "@eslint/eslintrc": "^3"
  },
  "peerDependencies": {
    "next": "16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
